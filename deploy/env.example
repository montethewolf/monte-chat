# hlv-discord configuration.
# Start with README.md for a fresh installation, including the pinned v8 gateway.
# Install to ~/.config/hlv-discord/env with mode 600 (chmod 600).
# Path examples below show defaults. Use absolute paths when overriding:
# environment files do not expand ~; leaving overrides unset uses your home.
# The commented ~ paths describe defaults; replace ~ with the real home path
# before uncommenting any path override.

# Discord application (create at https://discord.com/developers/applications;
# use a dedicated voice bot, separate from the existing Hermes text bot: this
# bridge replaces its application's guild slash commands on startup;
# invite with scopes bot + applications.commands, permissions View Channels,
# Connect, Speak, Send Messages, Send Messages in Threads; no privileged intents needed)
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
# Your own Discord user id: the only user the bridge listens to (and whose
# voice presence the bot follows — it joins/leaves voice when you do)
DISCORD_USER_ID=

# Text channel for mirrored notifications/transcripts when the bot auto-joined
# (a manual /join binds to the channel the command was typed in instead)
#DISCORD_TEXT_CHANNEL_ID=

# Hermes Live Voice gateway (read the effective port from
# the selected Hermes profile's hermes-live/config.env after the pinned CLI's setup).
# Replace 8788 if setup chose another port. Project roots belong in the gateway's
# separate environment file, not this Discord bridge file (see README.md).
HLV_URL=ws://127.0.0.1:8788/v1/live
# Only needed when the gateway has HERMES_LIVE_AUTH_TOKEN set (sent as a
# Bearer header, never as a URL parameter)
# This is not the Hermes API key or the voice-provider key.
#HLV_TOKEN=

# Version-3 atomic session/focus state with stable discussion ids (legacy state imported)
#HLV_STATE_FILE=~/.local/state/hlv-discord/state.json

# End-of-utterance debounce; the main latency knob. Lower = snappier turns,
# higher = fewer mid-sentence splits.
#DISCORD_SILENCE_MS=500

# Zero-pad flushed after each utterance: flushes the FIR tail and guarantees
# the >=100ms provider commit. Sent in one burst; adds no real latency.
#HLV_END_PAD_MS=240

# Post voice conversation to text: off (default; operational notices only),
# on (your words, replies, and task results). Legacy auto is interpreted as off.
# Runtime changes via `hlv-discord-ctl mirror on|off` or /mirror persist in
# MIRROR_STATE_FILE and override this default.
#MIRROR_TRANSCRIPTS=off
#MIRROR_STATE_FILE=~/.local/state/hlv-discord/mirror.json

# --- Call-start brief + thread focus ---------------------------------------

# Set to 0 to disable the system brief injected when a voice session starts
#BRIEF_ENABLED=1
# Brief size cap (realtime context is billed every turn — keep it compact)
#BRIEF_MAX_CHARS=1800
# Re-brief throttle: an HLV reconnect to the same session within this window
# does not resend (a /focus rebind always briefs; /brief forces one)
#BRIEF_TTL_MIN=15

# Legacy focus input for first migration only; new focus persists in HLV_STATE_FILE
#FOCUS_STATE_FILE=~/.local/state/hlv-discord/focus.json

# Read-only Hermes state used by the brief and /focus thread resolution.
# All default under HERMES_HOME (default ~/.hermes); override individually:
#HERMES_HOME=~/.hermes
#HERMES_STATE_DB=~/.hermes/state.db
#HERMES_KANBAN_DB=~/.hermes/kanban.db
#HERMES_CRON_DB=~/.hermes/cron/executions.db
#HERMES_CRON_JOBS=~/.hermes/cron/jobs.json
#HERMES_GATEWAY_STATE=~/.hermes/gateway_state.json
